# Copy to /etc/algo-bot/telegram.env on the server and set mode 0600.
# Revoke the token previously stored in config.py and use a newly issued token.
TELEGRAM_BOT_TOKEN=replace_with_new_botfather_token
TELEGRAM_ADMIN_IDS=replace_with_comma_separated_numeric_ids

AUTO_FEEDBACK_ENABLED=false
AUTO_FEEDBACK_MAX_CONCURRENT=5
AUTO_FEEDBACK_SEND_SPACING_SEC=0.05
AUTO_FEEDBACK_TEST_CLEANUP_TTL_HOURS=2
